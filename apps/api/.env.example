# Copy this file to .env: cp .env.example .env

# SQLite file, relative to apps/api
DATABASE_URL="file:./dev.db"

# Seed passwords for the demo accounts (see the README for the logins).
# These defaults are written down only so reviewers can log in. In a real
# project they'd be set per environment in .env or a secrets manager and
# never committed. The seed uses these defaults if they're not set.
SEED_ADMIN_PASSWORD="Admin123!"
SEED_CUSTOMER_PASSWORD="Customer123!"
